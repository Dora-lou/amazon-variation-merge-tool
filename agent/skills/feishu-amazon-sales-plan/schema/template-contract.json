    "fetch_latest_github_main_each_run": true,
    "no_local_skill_installation_required": true,
    "no_user_master_upload_per_run": true,
    "stop_if_github_skill_or_template_unavailable": true,
    "sales_plan_actual_sales_in_monthly_review_only": true,
