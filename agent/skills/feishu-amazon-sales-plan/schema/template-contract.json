  "style_palette": {
    "month_title_yellow": "#FFE84A",
    "summary_label_pink": "#F9E3EC",
    "summary_result_teal": "#D9F0EC",
    "input_light_blue": "#EAF3FB",
    "fee_input_light_yellow": "#FFF7DF",
    "formula_result_light_green": "#E2F0D9",
    "profit_focus_green": "#A9D18E",
    "table_header_light_blue": "#D9EAF7",
    "note_light_gray": "#F6F8FA",
    "price_light_orange": "#FCE4D6",
    "editable_blue_text": "#1673B8",
    "font_color": "#000000"
  },
  "formula_contract": {
    "plan_month_sales": "ROUND(SKU规划总库存 * 工作台库存消化目标 * 当月月目标规划比例, 0)",
    "total_stock": "SUM(FBA可售, FBA待调仓, FBA入库中, FBA实际在途, FBA计划入库, AWD可用, AWD标发在途)",
    "inventory_target": "ROUND(规划总库存 * 工作台库存消化目标, 0)",
    "remaining_stock": "规划总库存 - 后续计划量",
    "sell_through": "后续计划量 / 规划总库存",
    "actual_variance": "实际销量 - 原计划月销量",
    "weighted_average_price": "IFERROR(SUMPRODUCT(SKU月销量, SKU月售价) / SUM(SKU月销量), 0)",
    "sales_revenue": "SUMPRODUCT(SKU月销量, SKU月售价)",
    "ad_spend": "销售额 * 当月TACOS",
    "unit_profit": "售价 - 固定成本 - 售价*(佣金率+其他售价计提率+TACOS+仓储率) - 固定成本*退货率",
    "competitor_month_share": "竞品该月销量 / 该竞品四月合计",
    "competitor_median": "MEDIAN(合格竞品该月占比)",
    "competitor_normalized": "该月中位数 / 四个月中位数之和",
    "pending_quantity": "MAX(所选月计划销量 - 实际销量, 0)",
    "discounted_price": "售价 * (1 - 生效折扣率)"
  }
}
